# ============================================================================
# Modelo de configuração do Sistema de Acompanhamento CERNE — IpêTech Paraíso
#
# COMO USAR
#   1. Copie este arquivo para `.env` na raiz do projeto.
#   2. Preencha os valores do seu ambiente.
#   3. NUNCA versione o `.env` — ele guarda segredos. O .gitignore já o ignora.
#      Este `.env.example` é só o modelo, e pode ir para o GitHub.
#
# Para DESENVOLVIMENTO na sua máquina você não precisa de nada disto: sem
# nenhuma variável definida, o sistema já roda com SQLite, arquivos na pasta
# `media/` e DEBUG ligado.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. Básico
# ----------------------------------------------------------------------------

# Chave que protege sessões e logins. OBRIGATÓRIA em produção.
# Gere a sua com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Nunca reaproveite uma chave que já apareceu em tela, log ou conversa.
CERNE_SECRET_KEY=troque-por-uma-chave-gerada

# 1 em desenvolvimento, 0 em produção. Com 0, o Django esconde os detalhes de
# erro do usuário final e exige as demais configurações abaixo.
CERNE_DEBUG=0

# Domínios pelos quais o sistema responde, separados por vírgula.
# Sem isto correto, o Django recusa todas as requisições em produção.
CERNE_ALLOWED_HOSTS=cerne.ipetech.org.br

# Endereço completo (com https://) usado nos formulários. Necessário quando o
# sistema fica atrás de HTTPS em um domínio.
CERNE_CSRF_TRUSTED_ORIGINS=https://cerne.ipetech.org.br


# ----------------------------------------------------------------------------
# 2. Arquivos de evidência no Google Cloud Storage
#
# Defina CERNE_GCS_BUCKET para guardar os anexos no Google Cloud Storage.
# Sem essa variável, os arquivos ficam na pasta local (bom para desenvolvimento
# ou para rodar numa máquina do parque).
# ----------------------------------------------------------------------------

# Nome do bucket (só o nome, sem gs:// e sem barras).
CERNE_GCS_BUCKET=ipetechcerne

# ID do projeto no Google Cloud.
CERNE_GCS_PROJETO=ipetechcerne

# Subpasta dentro do bucket, se você quiser separar ambientes no mesmo bucket.
# Ex.: producao  ou  homologacao. Deixe vazio para gravar na raiz.
CERNE_GCS_PREFIXO=

# --- SOBRE A CREDENCIAL ---
#
# Rodando no Google Cloud (Cloud Run, Compute Engine), NÃO é preciso nenhuma
# variável de credencial: você anexa a conta de serviço ao serviço e a
# aplicação recebe credencial automática, de curta duração, renovada sozinha.
# Nada de arquivo de chave para vazar.
#
# Só se você hospedar FORA do Google Cloud seria necessário um arquivo de
# chave, na variável abaixo. Mas atenção: organizações novas bloqueiam a
# criação de chaves por padrão (política iam.disableServiceAccountKeyCreation).
# GOOGLE_APPLICATION_CREDENTIALS=/etc/segredos/gcs-cerne.json
#
# Os anexos NÃO são acessados por link direto do bucket. Eles são entregues
# pela rota /evidencias/<id>/arquivo/ do próprio sistema, que exige login.
# Por isso não há configuração de validade de link.

# Alternativa ao GCS: pasta local onde os anexos são gravados.
# Use quando NÃO houver bucket. Aceita caminho de rede ou pasta sincronizada.
# CERNE_MEDIA_ROOT=C:\Users\Windows\Meu Drive\IpeTech-CERNE\evidencias


# ----------------------------------------------------------------------------
# 3. Banco de dados
#
# Padrão: SQLite (arquivo db.sqlite3). Em servidor, prefira PostgreSQL: em
# hospedagem com disco efêmero o arquivo do SQLite é perdido a cada reinício.
# ----------------------------------------------------------------------------

CERNE_DB_ENGINE=postgres
CERNE_DB_NAME=cerne
CERNE_DB_USER=cerne
CERNE_DB_PASSWORD=troque-pela-senha-do-banco
CERNE_DB_HOST=localhost
CERNE_DB_PORT=5432

# Se ficar no SQLite, você pode mover o arquivo do banco para fora de uma pasta
# sincronizada (OneDrive, Google Drive). Banco em pasta de sincronização pode
# corromper quando duas máquinas mexem ao mesmo tempo.
# CERNE_DB_PATH=C:\dados-cerne\db.sqlite3


# ----------------------------------------------------------------------------
# 4. Segurança em produção (só valem com CERNE_DEBUG=0)
# ----------------------------------------------------------------------------

# 1 = exige HTTPS, marca os cookies como seguros e ativa HSTS.
# Só use 0 se o sistema ficar em rede interna sem certificado.
CERNE_HTTPS=1

# Ao testar HTTPS pela primeira vez, comece baixo (ex.: 3600) e aumente depois.
# O HSTS faz o navegador memorizar a exigência de HTTPS por este tempo.
CERNE_HSTS_SEGUNDOS=31536000

# Tempo de inatividade até encerrar a sessão. 43200 = 12 horas.
CERNE_SESSAO_SEGUNDOS=43200


# ----------------------------------------------------------------------------
# 5. E-mail (recuperação de senha)
#
# Sem CERNE_EMAIL_HOST, o e-mail é apenas impresso no log do servidor — o que
# serve para desenvolvimento, mas em produção ninguém recebe o link.
# ----------------------------------------------------------------------------

CERNE_EMAIL_HOST=smtp.seuprovedor.com.br
CERNE_EMAIL_PORT=587
CERNE_EMAIL_USUARIO=cerne@ipetech.org.br
CERNE_EMAIL_SENHA=troque-pela-senha-do-email
CERNE_EMAIL_TLS=1
CERNE_EMAIL_SSL=0
CERNE_EMAIL_REMETENTE=Acompanhamento CERNE <cerne@ipetech.org.br>


# ----------------------------------------------------------------------------
# 6. Arquivos estáticos
# ----------------------------------------------------------------------------

# Pasta onde `python manage.py collectstatic` reúne CSS e ícones.
# O padrão (staticfiles/ na raiz) serve para a maioria dos casos.
# CERNE_STATIC_ROOT=/var/www/cerne/staticfiles
